{
  "name": "input-terminal",
  "version": "0.7.0",
  "description": "Turn any HTMLInputElement into a terminal interface.",
  "keywords": [
    "terminal",
    "input",
    "command",
    "browser",
    "dom"
  ],
  "homepage": "https://nickesc.github.io/input-terminal/",
  "bugs": {
    "url": "https://github.com/nickesc/input-terminal/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickesc/input-terminal.git"
  },
  "license": "MIT",
  "author": "N. Escobar <nick@nickesc.io> (https://nickesc.github.io/)",
  "type": "module",
  "main": "build/input-terminal.js",
  "types": "build/input-terminal.d.ts",
  "exports": {
    ".": {
      "types": "./build/input-terminal.d.ts",
      "default": "./build/input-terminal.js"
    }
  },
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest --reporter=verbose",
    "coverage": "vitest run --coverage",
    "docs": "npm run build:site && typedoc && npm run capsule",
    "capsule": "node scripts/capsule.mjs",
    "build": "npx tsc",
    "build:docs": "npm run build && npm run docs",
    "build:site": "npx tsc -p tsconfig.docs.json"
  },
  "files": [
    "build/**/*",
    "README.md",
    "docs/icon.svg",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "tsx": "^4.23.0",
    "typedoc": "^0.28.20",
    "typedoc-github-theme": "^0.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
