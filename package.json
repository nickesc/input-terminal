{
  "name": "input-terminal",
  "version": "0.9.0",
  "description": "Turn any HTMLInputElement into a terminal interface.",
  "keywords": [
    "terminal",
    "input",
    "command",
    "browser",
    "dom"
  ],
  "homepage": "https://nickesc.github.io/input-terminal/",
  "bugs": {
    "url": "https://github.com/nickesc/input-terminal/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickesc/input-terminal.git"
  },
  "license": "MIT",
  "author": "N. Escobar <nick@nickesc.io> (https://nickesc.github.io/)",
  "type": "module",
  "main": "build/input-terminal.js",
  "types": "build/input-terminal.d.ts",
  "exports": {
    ".": {
      "types": "./build/input-terminal.d.ts",
      "default": "./build/input-terminal.js"
    },
    "./dom": {
      "types": "./build/dom/index.d.ts",
      "default": "./build/dom/index.js"
    },
    "./svelte": {
      "types": "./build/svelte/index.d.ts",
      "default": "./build/svelte/index.js"
    }
  },
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "vitest run --typecheck.enabled --reporter=verbose",
    "test:watch": "vitest --reporter=verbose",
    "coverage": "vitest run --coverage",
    "build": "npx tsc",
    "prepack": "npm run build",
    "build:site": "npx tsc -p tsconfig.docs.json",
    "site:assets": "cp docs/input-demo.js site/input-demo.js && cp -R docs/fonts site/fonts",
    "capsule": "node scripts/capsule.mjs",
    "docs": "typedoc && npm run build:site && npm run site:assets && npm run capsule",
    "build:docs": "npm run build && npm run docs"
  },
  "files": [
    "build/**/*",
    "README.md",
    "docs/icon.svg",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/jsdom": "^28.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "svelte": "^5.56.8",
    "tsx": "^4.23.0",
    "typedoc": "^0.28.20",
    "typedoc-github-theme": "^0.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "svelte": "^5.7.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true
  }
}
